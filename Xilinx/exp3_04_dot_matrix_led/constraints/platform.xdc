## Local platform constraints for exp3-04_dot_matrix_led
## Device: xc7a100tfgg484-3
## Dot matrix uses BSW-A group for row/column multiplexing
## Updated: 2026-05-26

## Independent core-board 125 MHz differential system clock, matching the
## verified exp2-01 counter design. R4/T4 = SYS_CLK_P/N, Bank 34 MRCC pair.
set_property -quiet PACKAGE_PIN R4 [get_ports -quiet clk_in_p]
set_property -quiet PACKAGE_PIN T4 [get_ports -quiet clk_in_n]
set_property -quiet IOSTANDARD DIFF_SSTL15 [get_ports -quiet {clk_in_p clk_in_n}]
create_clock -name sys_clk -period 8.000 [get_ports -quiet clk_in_p]

set_property -quiet PACKAGE_PIN AB6  [get_ports -quiet {PI[0]}]
set_property -quiet PACKAGE_PIN V9  [get_ports -quiet {PI[1]}]
set_property -quiet PACKAGE_PIN V8  [get_ports -quiet {PI[2]}]
set_property -quiet PACKAGE_PIN AA8  [get_ports -quiet {PI[3]}]
set_property -quiet PACKAGE_PIN AB8  [get_ports -quiet {PI[4]}]
set_property -quiet PACKAGE_PIN Y8  [get_ports -quiet {PI[5]}]
set_property -quiet PACKAGE_PIN Y7  [get_ports -quiet {PI[6]}]
set_property -quiet PACKAGE_PIN W9  [get_ports -quiet {PI[7]}]
set_property -quiet PACKAGE_PIN Y12  [get_ports -quiet {PI[8]}]
set_property -quiet PACKAGE_PIN AA13  [get_ports -quiet {PI[9]}]
set_property -quiet PACKAGE_PIN AB13  [get_ports -quiet {PI[10]}]
set_property -quiet PACKAGE_PIN T16  [get_ports -quiet {PI[11]}]
set_property -quiet PACKAGE_PIN U16  [get_ports -quiet {PI[12]}]
set_property -quiet PACKAGE_PIN D15  [get_ports -quiet {PI[13]}]
set_property -quiet PACKAGE_PIN B22  [get_ports -quiet {PI[14]}]
set_property -quiet PACKAGE_PIN T6  [get_ports -quiet {PI[15]}]
set_property -quiet IOSTANDARD LVCMOS33 [get_ports -quiet {PI[0] PI[1] PI[2] PI[3] PI[4] PI[5] PI[6] PI[7] PI[8] PI[9] PI[10] PI[11] PI[12] PI[13] PI[14] PI[15]}]

