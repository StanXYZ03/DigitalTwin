## Dot matrix I_COL (4 column selects) — BANK14
set_property -quiet PACKAGE_PIN P14  [get_ports -quiet {I_COL[0]}]
set_property -quiet PACKAGE_PIN R14  [get_ports -quiet {I_COL[1]}]
set_property -quiet PACKAGE_PIN P19  [get_ports -quiet {I_COL[2]}]
